{
  "manifest_version": 3,
  "name": "Proofwake — Shadowbill Collector",
  "version": "0.3.0",
  "description": "Optional local AI-usage estimate telemetry for Proofwake.",
  "permissions": ["storage"],
  "host_permissions": ["https://chatgpt.com/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["config.js", "turn-tracker.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Proofwake",
    "default_popup": "popup.html"
  }
}
