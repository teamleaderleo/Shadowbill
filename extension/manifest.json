{
  "manifest_version": 3,
  "name": "Shadowbill Collector",
  "version": "0.1.0",
  "description": "Local-only ChatGPT usage telemetry for Shadowbill.",
  "permissions": ["storage"],
  "host_permissions": ["https://chatgpt.com/*", "http://127.0.0.1:7337/*"],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Shadowbill",
    "default_popup": "popup.html"
  }
}
