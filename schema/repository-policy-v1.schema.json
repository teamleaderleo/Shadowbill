{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:proofwake:schema:repository-policy:v1",
  "title": "Proofwake Repository Policy v1",
  "description": "Repository-owned expected evidence policy for Proofwake.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "repository", "lifecycle", "signals", "adapters"],
  "properties": {
    "version": { "const": 1 },
    "repository": { "$ref": "#/$defs/repository" },
    "lifecycle": { "$ref": "#/$defs/lifecycle" },
    "signals": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/signal" }
    },
    "adapters": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/adapter" }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$"
    },
    "repository": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "provider"],
          "properties": {
            "kind": { "const": "remote" },
            "id": {
              "type": "string",
              "minLength": 3,
              "maxLength": 201,
              "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,99})/[a-z0-9](?:[a-z0-9._-]{0,99})$"
            },
            "provider": { "$ref": "#/$defs/slug" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "localId", "displayName"],
          "properties": {
            "kind": { "const": "local" },
            "localId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "displayName": { "$ref": "#/$defs/slug" }
          }
        }
      ]
    },
    "lifecycle": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "dormantAfterDays"],
          "properties": {
            "state": { "const": "active" },
            "dormantAfterDays": { "type": "integer", "minimum": 1, "maximum": 3650 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": {
            "state": { "const": "dormant" }
          }
        }
      ]
    },
    "freshness": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": { "mode": { "const": "revision" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "hours"],
          "properties": {
            "mode": { "const": "duration" },
            "hours": { "type": "integer", "minimum": 1, "maximum": 87600 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": { "mode": { "const": "none" } }
        }
      ]
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "requirement", "subject", "freshness", "acceptedSources"],
      "properties": {
        "kind": {
          "enum": [
            "verify",
            "github-ci",
            "browser-review",
            "deployment",
            "service-check",
            "domain-check",
            "host-diagnostic",
            "local-diagnostic",
            "shadowbill-estimate"
          ]
        },
        "requirement": { "enum": ["required", "optional"] },
        "subject": { "enum": ["revision", "repository", "host", "service", "deployment"] },
        "freshness": { "$ref": "#/$defs/freshness" },
        "acceptedSources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 108,
            "pattern": "^(?:[a-z0-9][a-z0-9._-]{0,99}|adapter:[a-z0-9][a-z0-9._-]{0,99})$"
          }
        }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "path", "schema", "trust"],
      "properties": {
        "name": { "$ref": "#/$defs/slug" },
        "type": { "const": "receipt-file" },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*[:\\s])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[?*\\[\\]{}])(?!.*\\\\).+$"
        },
        "schema": { "type": "string", "minLength": 1, "maxLength": 256 },
        "trust": {
          "enum": [
            "local-operator",
            "signed-provider",
            "verified-receipt",
            "authenticated-client",
            "untrusted-observation"
          ]
        }
      }
    }
  }
}
